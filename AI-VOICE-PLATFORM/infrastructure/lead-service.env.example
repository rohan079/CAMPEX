# Copy to lead-service.env. Contains the Meta/WhatsApp secrets; the voice service never sees this file.
ENVIRONMENT=development

BUSINESS_NAME=CAMPEX
BUSINESS_DESCRIPTION=
BUSINESS_TIMEZONE=Asia/Kolkata
FOLLOW_UP_CALL_DAYS=7
CALL_POLL_SECONDS=3
VOICE_MAX_CONCURRENT_CALLS=1

META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=vXX.X

# Must match INTERNAL_SERVICE_KEY in voice-service.env.
INTERNAL_SERVICE_KEY=change-me

# Required when ENVIRONMENT is not "development".
AD_POPUP_TOKEN=
DASHBOARD_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
