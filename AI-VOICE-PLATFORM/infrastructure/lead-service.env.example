# Copy to lead-service.env. Contains the Meta/WhatsApp secrets; the voice service never sees this file.
ENVIRONMENT=development

# Docker Compose supplies these from its PostgreSQL service. For Railway, configure
# JDBC DATABASE_URL plus DATABASE_USER and DATABASE_PASSWORD in the service Variables tab.
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

BUSINESS_NAME=CAMPEX
BUSINESS_DESCRIPTION=
BUSINESS_TIMEZONE=Asia/Kolkata
FOLLOW_UP_CALL_DAYS=7
CALL_POLL_SECONDS=3
VOICE_MAX_CONCURRENT_CALLS=1

# Optional legacy password admin (unused when Firebase login is enabled).
CAMPEX_ADMIN_PASSWORD_HASH=
CAMPEX_ADMIN_SESSION_TTL_SECONDS=28800

# Firebase Google/Facebook login. Dashboard APIs require a Firebase Bearer token.
FIREBASE_PROJECT_ID=campex-f3ada
# Optional; token verification uses Google JWKS and does not need the web API key.
FIREBASE_WEB_API_KEY=

META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=vXX.X
META_APP_ID=
META_OAUTH_REDIRECT_URI=https://campex-production.up.railway.app/oauth/meta/callback
META_GRAPH_API_VERSION=v27.0
# Facebook Login for Business configuration id (Channels → Connect Meta Ads).
# Create under Meta App → Facebook Login for Business → Configurations with ads + pages + Instagram permissions.
META_LOGIN_CONFIG_ID=
META_OAUTH_SCOPES=ads_management,ads_read,business_management,pages_show_list,pages_read_engagement,instagram_basic,instagram_manage_insights
META_TOKEN_ENCRYPTION_KEY=
CAMPEX_FRONTEND_URL=https://campexdashboard.vercel.app

# Must match INTERNAL_SERVICE_KEY in voice-service.env.
INTERNAL_SERVICE_KEY=change-me

# Required when ENVIRONMENT is not "development".
AD_POPUP_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VOICE_SERVICE_URL=http://localhost:8000
VOICE_SERVICE_TIMEOUT_SECONDS=30

# --- Phase 1: measurement foundation ---
# Firebase emails that can access every client (comma separated). Everyone else needs a client membership.
CAMPEX_PLATFORM_ADMIN_EMAILS=
# Meta Conversions API dispatch. Events are always stored; nothing is sent to Meta unless this is true.
META_CAPI_ENABLED=false
META_CAPI_MAX_ATTEMPTS=8
META_CAPI_BASE_BACKOFF_SECONDS=30
META_CAPI_BATCH_SIZE=50
# Public tracking endpoint rate limits (per instance, per minute).
TRACKING_RATE_LIMIT_PER_IP=120
TRACKING_RATE_LIMIT_PER_PIXEL=3000
# Retention: events and consent records are deleted after TRACKING_RETENTION_DAYS; IP address and user agent
# are cleared from events after TRACKING_PII_RETENTION_DAYS.
TRACKING_RETENTION_DAYS=395
TRACKING_PII_RETENTION_DAYS=30
