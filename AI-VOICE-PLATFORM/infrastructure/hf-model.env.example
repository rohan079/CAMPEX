# Copy to hf-model.env. Keep the real Hugging Face token out of source control.
# Request access to ai4bharat/indic-parler-tts and review/accept its gated model terms first.
HF_TOKEN=

# Use cpu only for smoke/development tests; real-time serving needs a CUDA GPU.
INDIC_TTS_DEVICE=cuda
INDIC_TTS_SPEAKER=Lalitha
