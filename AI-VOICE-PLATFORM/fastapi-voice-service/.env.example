ENVIRONMENT=development
CALL_PROVIDER=edesy

# Choose the media/conversation engine for Edesy calls: hf or openai_realtime.
SPEECH_ENGINE=hf

# Edesy CPaaS
EDESY_API_BASE_URL=https://voice-api.edesy.in/v1
EDESY_API_KEY=
EDESY_FROM_NUMBER=+91XXXXXXXXXX
EDESY_MEDIA_WS_URL=wss://voice.example.com/media/edesy
EDESY_STREAM_TOKEN=replace-with-long-random-secret
EDESY_STATUS_CALLBACK_URL=https://voice.example.com/webhooks/edesy/status
EDESY_WEBHOOK_SECRET=
EDESY_CALL_TIMEOUT_SECONDS=60

# Local Hugging Face Realtime service (kept private on the Compose network).
HF_SPEECH_WS_URL=ws://hf-speech-service:8765/v1/realtime?model=local
HF_CONNECT_TIMEOUT_SECONDS=15
MAX_CONCURRENT_CALLS=1
# OpenAI Realtime speech-to-speech (used only with SPEECH_ENGINE=openai_realtime).
OPENAI_API_KEY=
OPENAI_REALTIME_WS_URL=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_CONNECT_TIMEOUT_SECONDS=15

# Legacy OpenAI-managed SIP path. Only used with CALL_PROVIDER=openai_sip.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_VOICE=marin
SIP_PROVIDER_URL=
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=

# Legacy ElevenLabs preview only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_turbo_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_16000

# Server-side campaign copy assistant (separate from speech-engine selection).
# Campaign copy assistant. Empty AI_API_KEY falls back to OPENAI_API_KEY.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45

LEAD_SERVICE_URL=http://localhost:8080
INTERNAL_SERVICE_KEY=change-me
VOICE_WEBHOOK_SECRET=change-me
