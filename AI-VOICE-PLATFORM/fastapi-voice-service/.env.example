ENVIRONMENT=development

# Select Edesy CPaaS + local Hugging Face speech-to-speech for the migrated path.
# Set CALL_PROVIDER=openai_sip only to temporarily use the legacy provider.
CALL_PROVIDER=edesy

# Edesy CPaaS — place real credentials only in an ignored local .env / secret store.
EDESY_API_BASE_URL=https://voice-api.edesy.in/v1
EDESY_API_KEY=
EDESY_FROM_NUMBER=+91XXXXXXXXXX
# Public URL owned by this deployment, not voice-api.edesy.in.
EDESY_MEDIA_WS_URL=wss://voice.example.com/media/edesy
EDESY_STREAM_TOKEN=replace-with-long-random-secret
EDESY_STATUS_CALLBACK_URL=https://voice.example.com/webhooks/edesy/status
EDESY_WEBHOOK_SECRET=
EDESY_CALL_TIMEOUT_SECONDS=60

# Hugging Face speech-to-speech endpoint. Keep this on the private Compose network.
HF_SPEECH_WS_URL=ws://hf-speech-service:8765/v1/realtime?model=local
HF_CONNECT_TIMEOUT_SECONDS=15
MAX_CONCURRENT_CALLS=1

# Legacy OpenAI-managed SIP path (used only with CALL_PROVIDER=openai_sip).
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_VOICE=marin
SIP_PROVIDER_URL=
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=

# Legacy ElevenLabs preview only; not used for Edesy live-call audio.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_turbo_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_16000

# Server-side campaign copy assistant. For Ollama/vLLM, set AI_PROVIDER=openai_compatible
# and AI_BASE_URL to its private OpenAI-compatible /v1 endpoint.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45

# Spring lead service
LEAD_SERVICE_URL=http://localhost:8080
INTERNAL_SERVICE_KEY=change-me
VOICE_WEBHOOK_SECRET=change-me
