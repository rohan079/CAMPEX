# Vercel serverless proxy runtime only; do not add the VITE_ prefix.
# Local Vite development uses its dev proxy and defaults to localhost:8080.
CLIENT_SERVICE_URL=

# Firebase web app config (required). Keep real values in the git-ignored .env.local and in Vercel
# project environment variables; nothing is hard-coded in source.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Phase 1: public origin of the Spring lead service that serves /campex.js, used only to render the
# install snippet on Tracking → Install. It is not a secret (websites load the script from it).
VITE_CAMPEX_TRACKING_URL=

# Public HTTPS URL of the Spring lead service (e.g. the Railway domain). Video uploads go there directly because
# Vercel functions accept at most ~4.5 MB. Add the dashboard's domain to CORS_ORIGINS on the lead service.
# Empty = uploads use the same origin (fine for local development).
CAMPEX_UPLOAD_URL=
