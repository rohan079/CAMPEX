# Vercel serverless proxy runtime only; do not add the VITE_ prefix.
# Local Vite development uses its dev proxy and defaults to localhost:8080.
CLIENT_SERVICE_URL=

# Optional Firebase overrides (defaults match the Campex Firebase web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
